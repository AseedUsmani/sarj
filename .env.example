# Service
PORT=8000
MODE=full                      # baseline | router | full
GIT_SHA=dev

# Upstreams (not needed for step 1)
GROQ_API_KEY=
DATABASE_URL=

# Tunables — set SIMILARITY_THRESHOLD from the sweep, not by guessing
SIMILARITY_THRESHOLD=0.92
CONFIDENCE_FLOOR=0.6
CLASSIFIER_VERSION=v1
TOOL_SOURCE=live               # live | fixture (fixture pins upstream for eval runs)
RATE_LIMIT_PER_MIN=60
